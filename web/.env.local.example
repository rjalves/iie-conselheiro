# Copie para .env.local e preencha. Proposta 03, seção 12.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:59321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon (supabase status -o env --workdir ../agente)>
# Só no servidor; usada apenas para excluir a própria conta.
SUPABASE_SERVICE_ROLE_KEY=<chave service_role>
# Webhook do agente no n8n (em dev: python -m n8n.simulado, a partir de agente/).
N8N_CHAT_URL=http://127.0.0.1:5679/webhook/iie-chat
N8N_CHAT_CHAVE=<mesma chave da credencial Header Auth do webhook>
LIMITE_DIARIO=40
# E-mails (confirmação de cadastro, nova senha): o Supabase Auth chama /api/auth/email (Send Email Hook) e o site
# envia pela API do Resend. Em dev local o Auth usa o Inbucket e não chama o hook; estas só valem publicadas.
RESEND_API_KEY=<chave da API do Resend, com acesso de envio ao domínio iiec.educacional.ia.br>
EMAIL_REMETENTE=IIE Conselheiro <nao-responda@iiec.educacional.ia.br>
SUPABASE_HOOK_EMAIL_SEGREDO=<v1,whsec_… igual ao GOTRUE_HOOK_SEND_EMAIL_SECRETS do Auth>
