# Copie para .env.local e preencha. Proposta 03, seção 12.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:59321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon (supabase status -o env --workdir ../agente)>
# Só no servidor; usada apenas para excluir a própria conta.
SUPABASE_SERVICE_ROLE_KEY=<chave service_role>
# Webhook do agente no n8n (em dev: python -m n8n.simulado, a partir de agente/).
N8N_CHAT_URL=http://127.0.0.1:5679/webhook/iie-chat
N8N_CHAT_CHAVE=<mesma chave da credencial Header Auth do webhook>
LIMITE_DIARIO=40
